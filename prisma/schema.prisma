// Prisma Schema for E-Commerce Platform - Stage 4: Category & Product Models

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum QuoteStatus {
  NEW
  REVIEWING
  QUOTED
  ACCEPTED
  REJECTED
  CONVERTED
  CLOSED
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String
  role      Role      @default(CUSTOMER)
  cart      Cart?
  wishlist  Wishlist?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([email])
  @@index([role])
  @@map("users")
}

model Category {
  id            String     @id @default(uuid())
  name          String     @unique
  slug          String     @unique
  description   String?
  imageUrl      String?
  isActive      Boolean    @default(true)
  parentId      String?
  parent        Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  subcategories Category[] @relation("CategoryHierarchy")
  products      Product[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([slug])
  @@index([parentId])
  @@index([isActive])
  @@map("categories")
}

model Product {
  id                 String           @id @default(uuid())
  name               String
  slug               String           @unique
  sku                String           @unique
  shortDescription   String?
  description        String?
  price              Decimal          @db.Decimal(10, 2)
  mrp                Decimal          @db.Decimal(10, 2)
  discountPercentage Decimal          @default(0) @db.Decimal(5, 2)
  taxPercentage      Decimal          @default(0) @db.Decimal(5, 2)
  stockQuantity      Int              @default(0)
  lowStockThreshold  Int              @default(5)
  weight             Decimal?         @db.Decimal(8, 2)
  specifications     Json?
  imageUrl           String?
  isActive           Boolean          @default(true)
  isFeatured         Boolean          @default(false)
  isNewArrival       Boolean          @default(false)
  isBestSeller       Boolean          @default(false)
  seoTitle           String?
  seoDescription     String?
  metaDescription    String?
  categoryId         String
  category           Category         @relation(fields: [categoryId], references: [id])
  images             ProductImage[]
  variants           ProductVariant[]
  cartItems          CartItem[]
  wishlistItems      WishlistItem[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([name])
  @@index([slug])
  @@index([sku])
  @@index([categoryId])
  @@index([isActive])
  @@index([isFeatured])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  url       String
  publicId  String?
  altText   String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([isPrimary])
  @@map("product_images")
}

model ProductVariant {
  id            String     @id @default(uuid())
  productId     String
  sku           String     @unique
  name          String
  price         Decimal    @db.Decimal(10, 2)
  mrp           Decimal    @db.Decimal(10, 2)
  stockQuantity Int        @default(0)
  attributes    Json?
  isActive      Boolean    @default(true)
  product       Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems     CartItem[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([productId])
  @@index([sku])
  @@map("product_variants")
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("carts")
}

model CartItem {
  id        String          @id @default(uuid())
  cartId    String
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity  Int             @default(1)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([cartId])
  @@index([productId])
  @@index([variantId])
  @@unique([cartId, productId, variantId])
  @@map("cart_items")
}

model Wishlist {
  id        String         @id @default(uuid())
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("wishlists")
}

model WishlistItem {
  id         String   @id @default(uuid())
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([wishlistId])
  @@index([productId])
  @@unique([wishlistId, productId])
  @@map("wishlist_items")
}

model Service {
  id               String         @id @default(uuid())
  name             String
  slug             String         @unique
  shortDescription String?
  description      String?
  imageUrl         String?
  gallery          Json?
  industries       Json?
  isActive         Boolean        @default(true)
  isFeatured       Boolean        @default(false)
  sortOrder        Int            @default(0)
  seoTitle         String?
  seoDescription   String?
  quoteRequests    QuoteRequest[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([slug])
  @@index([isActive])
  @@index([isFeatured])
  @@map("services")
}

model QuoteRequest {
  id                 String      @id @default(uuid())
  name               String
  email              String
  phone              String?
  company            String?
  serviceId          String?
  service            Service?    @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceName        String?
  projectDescription String
  quantity           Int?        @default(1)
  materialPreference String?
  deliveryDate       DateTime?
  fileUrl            String?
  additionalNotes    String?
  status             QuoteStatus @default(NEW)
  internalNotes      String?
  userId             String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([email])
  @@index([serviceId])
  @@index([status])
  @@map("quote_requests")
}

model CMSPage {
  id              String   @id @default(uuid())
  title           String
  slug            String   @unique
  content         Json?
  metaTitle       String?
  metaDescription String?
  isPublished     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([slug])
  @@map("cms_pages")
}

model Testimonial {
  id          String   @id @default(uuid())
  clientName  String
  company     String?
  designation String?
  avatarUrl   String?
  rating      Int      @default(5)
  content     String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@map("testimonials")
}

model FAQ {
  id        String   @id @default(uuid())
  question  String
  answer    String
  category  String?  @default("General")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([category])
  @@map("faqs")
}

model Banner {
  id        String   @id @default(uuid())
  title     String
  subtitle  String?
  imageUrl  String
  linkUrl   String?
  ctaText   String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("banners")
}

model SiteSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  @@index([key])
  @@map("site_settings")
}

model RazorpayWebhookEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique
  eventType   String
  payload     Json?
  processedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([eventId])
  @@index([eventType])
  @@map("razorpay_webhook_events")
}

enum ShipmentStatus {
  CREATED
  READY_TO_SHIP
  PACKED
  SHIPPED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  DELIVERY_ATTEMPTED
  FAILED
  RETURNED
  CANCELLED
}

model Shipment {
  id                    String                  @id @default(uuid())
  orderId               String
  orderNumber           String?
  shipmentNumber        String                  @unique
  provider              String                  @default("MANUAL")
  serviceType           String?
  awbNumber             String?                 @unique
  trackingNumber        String?                 @unique
  trackingUrl           String?
  status                ShipmentStatus          @default(CREATED)
  shippingCost          Decimal                 @default(0) @db.Decimal(10, 2)
  estimatedDeliveryDate DateTime?
  shippedAt             DateTime?
  deliveredAt           DateTime?
  cancelledAt           DateTime?
  labelUrl              String?
  labelFormat           String?
  labelGeneratedAt      DateTime?
  items                 Json?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  statusHistory         ShipmentStatusHistory[]

  @@index([orderId])
  @@index([shipmentNumber])
  @@index([awbNumber])
  @@index([trackingNumber])
  @@index([status])
  @@map("shipments")
}

model ShipmentStatusHistory {
  id          String         @id @default(uuid())
  shipmentId  String
  shipment    Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status      ShipmentStatus
  description String?
  location    String?
  timestamp   DateTime       @default(now())
  source      String         @default("ADMIN")
  createdAt   DateTime       @default(now())

  @@index([shipmentId])
  @@index([status])
  @@map("shipment_status_histories")
}


