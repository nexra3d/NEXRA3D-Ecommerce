# ==============================================================================
# SECURE DEPLOYMENT CONFIGURATION & ENVIRONMENT SECRETS
# ==============================================================================
# IMPORTANT: Never commit actual secret values or credentials to this file or source control.
# In production, inject secrets via your cloud container environment (e.g. Cloud Run, Docker).

# ------------------------------------------------------------------------------
# 1. DATABASE & POSTGRESQL (Enforce TLS / Restrict Direct Public Exposure)
# ------------------------------------------------------------------------------
# Ensure your PostgreSQL connection string enforces SSL (e.g. ?sslmode=require)
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require
DIRECT_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SESSION SECURITY
# ------------------------------------------------------------------------------
# Cryptographically random string (min 32 characters) for JWT HMAC-SHA256 signing
JWT_SECRET=

# ------------------------------------------------------------------------------
# 3. PAYMENT GATEWAY (RAZORPAY)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
VITE_RAZORPAY_KEY_ID=

# ------------------------------------------------------------------------------
# 4. TRANSACTIONAL EMAIL (RESEND)
# ------------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ------------------------------------------------------------------------------
# 5. MEDIA & CLOUD STORAGE (CLOUDINARY)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------------------
# 6. SHIPPING & LOGISTICS (DELHIVERY & NIMBUSPOST)
# ------------------------------------------------------------------------------
DELHIVERY_API_TOKEN=
DELHIVERY_BASE_URL=https://track.delhivery.com
DELHIVERY_ORIGIN_PINCODE=500032

NIMBUSPOST_API_BASE_URL=https://api.nimbuspost.com/v1
NIMBUSPOST_API_KEY=
NIMBUSPOST_API_SECRET=
NIMBUSPOST_EMAIL=
NIMBUSPOST_PASSWORD=

# ------------------------------------------------------------------------------
# 7. SUPABASE (OPTIONAL SYNC)
# ------------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 8. AI ASSISTANT (GEMINI)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
